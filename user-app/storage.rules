rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is authenticated 
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Get the user's role from Firestore
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Role helpers
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'superadmin');
    }

    function isModerator() {
      return isSignedIn() && (getUserRole() == 'moderator' || getUserRole() == 'admin' || getUserRole() == 'superadmin');
    }

    function isRetailer() {
      return isSignedIn() && getUserRole() == 'retailer';
    }
    
    // UPLOADS DIRECTORY
    match /ocr_uploads/{imageId} {
      // Consumers can view images (e.g., flyer images)
      allow read: if true;
      
      // Allow creation/updates ONLY if the user is a Retailer or an Admin
      // Restrict file size to 10MB and enforce image/pdf content type
      allow write: if (isRetailer() || isModerator()) 
                   && request.resource.size < 10 * 1024 * 1024 
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
                   
      allow delete: if isAdmin() || isRetailer(); // In a full implementation, we would verify ownership of the file via metadata, but assuming retailer scope is fine here.
    }
  }
}
